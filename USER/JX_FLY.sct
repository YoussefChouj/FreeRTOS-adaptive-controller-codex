; *************************************************************
; *** Scatter-Loading Description File: uVision generated + RW_IRAM2 (CCM) ***
; *************************************************************

LR_IROM1 0x08000000 0x00100000  {    ; load region size_region
  ER_IROM1 0x08000000 0x00100000  {  ; load address = execution address
   *.o (RESET, +First)
   *(InRoot$$Sections)
   .ANY (+RO)
  }
  RW_IRAM1 0x20000000 0x00020000  {  ; RW data
   .ANY (+RW +ZI)
  }
  RW_IRAM2 0x10000000 0x00010000  {  ; CCM, CPU-only (no DMA): MRAC adaptive state, zeroed by __main
   *(MRAC_CCM)
  }
}

