#!/usr/bin/env bash
# Tracked pre-commit hook. Runs the routed subset of tools/check.sh on the staged paths, so a doc-only commit
# pays for ~2 s (doc-paths + doc-budget), not the whole gate. Failures abort the commit; bypass with
# `git commit --no-verify`. Activated per-machine with `git config core.hooksPath .githooks`.
set -e
toplevel=$(git rev-parse --show-toplevel)
steps=$(bash "$toplevel/tools/check.sh" --route-list 2>/dev/null || true)
if [ -z "$steps" ]; then
    # The plain gate fallback: doc-paths and doc-budget must always run; a routed failure is not a hook failure.
    exec bash "$toplevel/tools/check.sh" doc-paths fw-lint row-meta doc-budget arm-syntax float
fi
exec bash "$toplevel/tools/check.sh" --quiet $steps
