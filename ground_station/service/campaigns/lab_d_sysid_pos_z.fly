# D-pos-z: vertical position-loop multisine (sysid_target=4, axis=z -> highPID.Des, 0.1-1.5 Hz, 0.15 m, two 30 s passes, 200 Hz stream).
# Identifies vertical altitude loop plant from highPID output to altitude.
# Ground analysis: python -m ground_station.autotune.cli <session> --loop pos --axis z. All values PROPOSED.
campaign lab-d-sysid-pos-z
rate 200
log velocity_loops camera_fusion sysid
slow 25 thrust_model xy_ctrl ekf_states estimator_truth optical_flow takeoff_gate nn4 drift_nn mrac_3l mrac_theta mrac_shadow
set g_xy_ctrl_kind=0 g_traj_ff_shift_s=0 g_land_xy_gate_cm=10
takeoff 0.5 mrac_injection=0
set sysid_target=4
hold 8
excite target=pos axis=z signal=multisine f0=0.1 f1=1.5 amp=0.15 duration_s=30
hold 3
excite target=pos axis=z signal=multisine f0=0.1 f1=1.5 amp=0.15 duration_s=30
set sysid_target=0
hold 3
land
