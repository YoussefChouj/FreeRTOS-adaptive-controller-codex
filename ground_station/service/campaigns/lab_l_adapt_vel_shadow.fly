# Adapt-vel (shadow): 40 s hover at 0.5 m with inner translational velocity MRAC (`layers xy inner`) in shadow (`mrac_injection=0`).
# Paired with `lab_l_adapt_vel_live` behind the W2/W4 `adapt` gate (optional: true). All marks PROPOSED.
campaign lab-l-adapt-vel-shadow
rate 100
log velocity_loops camera_fusion thrust_model xy_ctrl ekf_states optical_flow
slow 50 estimator_truth takeoff_gate nn4 drift_nn mrac_3l mrac_theta mrac_shadow
exp pid_3l
set g_traj_ff_shift_s=0 g_land_xy_gate_cm=10 g_xyc_delay_ticks=18
layers xy inner
takeoff 0.5 mrac_injection=0
hold 40
land
