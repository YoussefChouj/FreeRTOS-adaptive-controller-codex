# D-vel-xy: outer velocity-loop multisine (sysid_target=3, pitch->vx then roll->vy, 0.15-3 Hz, 25 cm/s, 30 s each, 200 Hz stream).
# Identifies closed-loop attitude + translational velocity plant (locxsPID/locysPID) with >=3-5x separation from angle wc.
# Ground analysis: python -m ground_station.autotune.cli <session> --loop vel --axis x (and --axis y). All values PROPOSED.
campaign lab-d-sysid-vel-xy
rate 200
log velocity_loops camera_fusion sysid
slow 25 thrust_model xy_ctrl ekf_states estimator_truth optical_flow takeoff_gate nn4 drift_nn mrac_3l mrac_theta mrac_shadow
set g_xy_ctrl_kind=0 g_traj_ff_shift_s=0 g_land_xy_gate_cm=10
takeoff 0.5 mrac_injection=0
set sysid_target=3
hold 8
excite target=vel axis=pitch signal=multisine f0=0.15 f1=3 amp=25 duration_s=30
hold 3
excite target=vel axis=roll signal=multisine f0=0.15 f1=3 amp=25 duration_s=30
set sysid_target=0
hold 3
land
