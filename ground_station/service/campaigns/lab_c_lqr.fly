# gains: defaults
# why: PID gains are unused by the LQR xy loop but stay live in RAM (rate loops 9-14 always fly; 24-35 fly if the PID fallback trips); reset them so F4 livetune gains do not carry in
# C: LQR on the same track (0.4 m x step, circle r30, figure-8 a30), gated pad landing, fusion 3
# Fly it: fly lab_c_lqr --once at >= 15.8 V resting. Score: step overshoot (debrief Setpoint moves) vs today's PID,
# tie-break circle + figure-8 xy rms. Plan: docs/lab/run-sheet-2026-10-14.md
campaign lab-c-lqr
rate 100
log velocity_loops camera_fusion
slow 50 nn4 xy_ctrl mrac_3l mrac_theta ekf_states estimator_truth thrust_model optical_flow takeoff_gate mrac_shadow
set g_xy_ctrl_kind=2 g_traj_ff_shift_s=0 g_land_xy_gate_cm=10 g_xyc_delay_ticks=21
takeoff 0.5
hold 3
goto x=0.4 y=0 z=0.5 dwell_s=4
hold 4
set traj_p.move_s=18 traj_p.ret_s=3 traj_p.hold_s=1 traj_p.profile=1 traj_p.ramp_s=2 traj_p.yaw_follow=0
preset circle circ_r_cm=30
hold 2
preset figure8 f8_a_cm=30
hold 3
land
