# mpc_3l matched reference: 3-layer adaptive matrix with xy_layers=inner and mrac_ref from=mpc
#   (fitted from mpc-alone-retest via `python -m ground_station.analysis.mrac_ref_fit <session> --kind mpc`).
# Fly it: fly lab_e_exp_mpc_matched --once at >= 15.8 V resting.
# exp mpc_3l = xy 3, kp 7, vp 16, lim 0, mdec 1, xyrm -1 (overridden by mrac_ref from=mpc).
campaign lab-e-exp-mpc-matched
rate 100
log velocity_loops camera_fusion
slow 50 nn4 xy_ctrl mrac_3l mrac_theta ekf_states estimator_truth thrust_model optical_flow takeoff_gate mrac_shadow
exp mpc_3l
set g_traj_ff_shift_s=0 g_land_xy_gate_cm=10 g_xyc_delay_ticks=21
xy_layers inner
mrac_ref from=mpc
takeoff 0.5
hold 3
set traj_p.move_s=12 traj_p.hold_s=1
preset figure8 f8_a_cm=30
hold 3
land
