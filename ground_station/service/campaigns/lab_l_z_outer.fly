# L-z (outer): altitude setpoint steps (three 0.15 m / 3 s steps, PROPOSED) from matrix hold with
#   `layers z outer` (z velocity, z position, or both; needs all-loop firmware).
# Fly it: fly lab_l_z_outer --once at >= 15.8 V resting.
campaign lab-l-z-outer
rate 100
log velocity_loops camera_fusion
slow 50 nn4 xy_ctrl mrac_3l mrac_theta ekf_states estimator_truth thrust_model optical_flow takeoff_gate mrac_shadow
exp pid_3l
set g_traj_ff_shift_s=0 g_land_xy_gate_cm=10 g_xyc_delay_ticks=21
layers z outer
takeoff 0.5
hold 3
step axis=z delta=0.15 hold=3
step axis=z delta=-0.15 hold=3
step axis=z delta=0.15 hold=3
hold 3
land
