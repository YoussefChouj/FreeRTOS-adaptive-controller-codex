# XY layer A/B (inner): 3-layer adaptive matrix (pid_3l) with xy_layers=inner, hover then figure-8.
# Arms: lab_e_xyl_inner, lab_e_xyl_outer, lab_e_xyl_both (flown A B C C B A).
# Fly it: fly lab_e_xyl_inner --once at >= 15.8 V resting.
campaign lab-e-xyl-inner
rate 100
log velocity_loops camera_fusion
slow 50 nn4 xy_ctrl mrac_3l mrac_theta ekf_states estimator_truth thrust_model optical_flow takeoff_gate mrac_shadow
exp pid_3l
set g_traj_ff_shift_s=0 g_land_xy_gate_cm=10 g_xyc_delay_ticks=21
xy_layers inner
takeoff 0.5
hold 3
set traj_p.move_s=12 traj_p.hold_s=1
preset figure8 f8_a_cm=30
hold 3
land
