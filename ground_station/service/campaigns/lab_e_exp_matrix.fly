# E: 3-layer adaptive matrix comparison: hover then figure-8 for each *_3l row (pid_3l, adrc_3l, lqr_3l, mpc_3l)
# Fly it: fly lab_e_exp_matrix --once at >= 15.8 V resting.
# Select the experiment below for each flight round (pid_3l, adrc_3l, lqr_3l, mpc_3l):
#   exp pid_3l   (xy=0, kp=7, vp=16, lim=0, mdec=1, xyrm=0, bw=2.0)
#   exp adrc_3l  (xy=1, kp=7, vp=16, lim=0, mdec=1, xyrm=1, bw=2.2)
#   exp lqr_3l   (xy=2, kp=7, vp=16, lim=0, mdec=1, xyrm=2, bw=4.8)
#   exp mpc_3l   (xy=3, kp=7, vp=16, lim=0, mdec=1, xyrm=3, bw=4.4)
campaign lab-e-exp-matrix
rate 100
log velocity_loops camera_fusion
exp pid_3l
set g_xy_ctrl_kind=0 g_traj_ff_shift_s=0 g_land_xy_gate_cm=10
takeoff 0.5
hold 3
set traj_p.move_s=12 traj_p.hold_s=1
preset figure8 f8_a_cm=30
hold 3
land
