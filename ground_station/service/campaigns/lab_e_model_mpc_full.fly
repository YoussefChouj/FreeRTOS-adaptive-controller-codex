# Block 5b combined-fix FULL-SPEED figure-8 validation (2026-10-27): MPC full-speed figure-8 (f8_laps=2), gated ONLY after Block 5a half-speed passes.
# Combines Fix 1 (d=18, pred_lead=1) + Fix 2 (candidate gains written disarmed after chat OK) + Fix 3 (--gains rate35y104) + Fix 4 (slow_clock + profile=2). All marks PROPOSED.
campaign lab-e-model-mpc-full
rate 100
log velocity_loops camera_fusion thrust_model xy_ctrl ekf_states optical_flow
slow 50 estimator_truth takeoff_gate nn4 drift_nn mrac_3l mrac_theta mrac_shadow
exp mpc_3l
set g_traj_ff_shift_s=0 g_land_xy_gate_cm=10 g_xyc_delay_ticks=33 g_xyc_pred_lead=0 g_traj_slow_on=1 g_traj_slow_elo_cm=20 g_traj_slow_ehi_cm=45 g_traj_arrive_r_cm=15
takeoff 0.5 mrac_injection=0
set g_xyc_delay_ticks=18
hold 4
set traj_p.move_s=18 traj_p.ret_s=3 traj_p.hold_s=1 traj_p.profile=2 traj_p.ramp_s=2 traj_p.yaw_follow=0
preset figure8 f8_a_cm=30 f8_laps=2
hold 3
land
