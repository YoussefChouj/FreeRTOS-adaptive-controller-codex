# L-all (off): full multi-time-scale stack (`layers xy/att/yaw/z off`, needs all-loop firmware),
#   figure-8 + roll multisine + z and yaw steps (all step/excite values PROPOSED).
# Fly it: fly lab_l_all_off --once at >= 15.8 V resting.
campaign lab-l-all-off
rate 100
log velocity_loops camera_fusion
slow 50 nn4 xy_ctrl mrac_3l mrac_theta ekf_states estimator_truth thrust_model optical_flow takeoff_gate mrac_shadow
exp pid_3l
set g_traj_ff_shift_s=0 g_land_xy_gate_cm=10 g_xyc_delay_ticks=21
layers xy off
layers att off
layers yaw off
layers z off
takeoff 0.5
hold 3
set traj_p.move_s=12 traj_p.hold_s=1
preset figure8 f8_a_cm=30
hold 3
excite axis=roll signal=multisine f0=0.5 f1=15 amp=60 duration_s=30
step axis=z delta=0.15 hold=3
step axis=yaw delta=30 hold=3
hold 3
land
