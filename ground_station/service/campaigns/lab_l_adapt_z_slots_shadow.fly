# Adapt-z-slots (shadow): 40 s hover at 0.5 m with Z physics feature slots (`mrac_z_feat_mask=15`) learning in shadow (`mrac_injection=0`).
# Paired with `lab_l_adapt_z_slots_live` behind the W2/W4 `adapt` gate (optional: true). All marks PROPOSED.
campaign lab-l-adapt-z-slots-shadow
rate 100
log velocity_loops camera_fusion thrust_model xy_ctrl ekf_states optical_flow
slow 50 estimator_truth takeoff_gate nn4 drift_nn mrac_3l mrac_theta mrac_shadow
exp pid_3l
set g_traj_ff_shift_s=0 g_land_xy_gate_cm=10 g_xyc_delay_ticks=18 mrac_z_feat_mask=15
layers z inner
takeoff 0.5 mrac_injection=0
hold 40
land
