# P3/3 prior-warm: pid_3l seeded on the ground with Theta from the latest lab-p-pattern-learn session
#   (CMD 0x2F..0x34, warm=1), hover then figure-8. Pairs with lab_p_prior_cold.
# Fly it: fly lab_p_prior_warm --once at >= 15.8 V resting.
campaign lab-p-prior-warm
rate 100
log velocity_loops camera_fusion
slow 50 nn4 xy_ctrl mrac_3l mrac_theta ekf_states estimator_truth thrust_model optical_flow takeoff_gate mrac_shadow
exp pid_3l
set g_traj_ff_shift_s=0 g_land_xy_gate_cm=10 g_xyc_delay_ticks=21
mrac_prior from=latest:lab-p-pattern-learn
takeoff 0.5
hold 3
set traj_p.move_s=12 traj_p.hold_s=1
preset figure8 f8_a_cm=30
hold 3
land
