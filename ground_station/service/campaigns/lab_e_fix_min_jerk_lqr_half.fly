# Block 4c one-variable fix 2/4 (2026-10-27): LQR half-speed figure-8 with ONLY min-jerk trajectory profile (profile=2).
# Same-arm baseline: diag-figure8-half-speed-lqr (lab_e_diag_lqr_fig8_half.fly: d=12, slow_on=0, f8_laps=1).
# Tests R2 Fix 4 entry/exit kinematics (Cause b: cosine-ramp turnaround jerk excitation). All marks PROPOSED.
campaign lab-e-fix-min-jerk-lqr-half
rate 100
log velocity_loops camera_fusion thrust_model xy_ctrl ekf_states optical_flow
slow 50 estimator_truth takeoff_gate nn4 drift_nn mrac_3l mrac_theta mrac_shadow
exp lqr_3l
set g_traj_ff_shift_s=0 g_land_xy_gate_cm=10 g_xyc_delay_ticks=12 g_traj_slow_on=0
takeoff 0.5 mrac_injection=0
hold 3
set traj_p.move_s=18 traj_p.ret_s=3 traj_p.hold_s=1 traj_p.profile=2 traj_p.ramp_s=2 traj_p.yaw_follow=0
preset figure8 f8_a_cm=30 f8_laps=1
hold 3
land
