+bool bmi088_init(void)								//IMU≥ı ºªØ
+{
+	uint32_t cali_retries;
+	BMI088_Read_Acc_Data(ACC_ID);
+	BMI088_Read_Gyro_Data(GYRO_ID);
+	
+	delay_ms(100);
+	
+	BMI088_Write_Acc_Data(ACC_PWR_CONF,0x00);
+	BMI088_Write_Acc_Data(ACC_PWR_CTRL,0x04);
+	
+	BMI088_Read_Acc_Data(ACC_ID);
+	BMI088_Read_Gyro_Data(GYRO_ID);
+	
+	//≥ı ºªØ ±“™«Û∆Ù∂ØAccŒ™Normalƒ£ Ω£¨–Ë“™–¥PWRºƒ¥Ê∆˜
+	
+	Acc_ID = BMI088_Read_Acc_Data(ACC_ID);
+	Gyro_ID = BMI088_Read_Gyro_Data(GYRO_ID);
+	
+	
+	if(Acc_ID != 0x1e || Gyro_ID != 0x0f)		//ID_Wrong
+	{
+		BMI088_Write_Acc_Data(ACC_SOFT_R,0XB6);
+		BMI088_Write_Gyro_Data(GYRO_SOFT_R,0XB6);
+		delay_ms(50);
+		sensor.sensor_ok = 0U;
+		return FALSE;
+	}
+	
+	if((BMI088_Read_Acc_Data(ACC_ERR) & 0x1D/*0b00011101*/ )!= 0)																	//Acc_Err_Ocur
+	{
+		BMI088_Write_Acc_Data(ACC_SOFT_R,0XB6);
+		BMI088_Write_Gyro_Data(GYRO_SOFT_R,0XB6);
+		delay_ms(50);
+		sensor.sensor_ok = 0U;
+		return FALSE;
+	}
+	
+//Acc≈‰÷√
+	//≈‰÷√ODR£¨Filter
+	BMI088_Write_Acc_Data(ACC_CONF,0XAC);//0b10101100);															//≈‰÷√º”ÀŸ∂»º∆ ‰≥ˆÀŸ¬ 1600Hz£¨Normal ‰≥ˆƒ£ Ω
+	delay_ms(10);
+	//≈‰÷√≤‚¡ø∑∂Œß
+	BMI088_Write_Acc_Data(ACC_RANGE,0X01);//0b00000001);														//≈‰÷√º”ÀŸ∂»º∆ ‰≥ˆ∑∂Œß+-6g
+	delay_ms(10);
+	//≈‰÷√µÁ‘¥ Ù–‘
+	BMI088_Write_Acc_Data(ACC_PWR_CONF,0x00);															//≈‰÷√Ω¯»ÎªÓ∂Øƒ£ Ω
+	delay_ms(10);
+	//≈‰÷√µÁ‘¥ø™πÿ
+	BMI088_Write_Acc_Data(ACC_PWR_CTRL,0x04);															//¥Úø™º”ÀŸ∂»º∆µÁ‘¥
+	delay_ms(10);
+	//º∆À„º”ÀŸ∂»º∆¡ø≥Ãœµ ˝
+	Acc_Range_Coe = pow(2,(BMI088_Read_Acc_Data(ACC_RANGE)+1)) + 2;
+	delay_ms(10);
+	
+//Gyro≈‰÷√
+	//≈‰÷√≤‚¡ø∑∂Œß
+	BMI088_Write_Gyro_Data(GYRO_RANGE,0X01);															//≈‰÷√Õ”¬›“«¡ø≥Ã+-1000°„/s
+	delay_ms(10);
+	//≈‰÷√µÕÕ®¬À≤®¥¯øÌ
+	BMI088_Write_Gyro_Data(GYRO_BANDW,0X00);															//≈‰÷√ ‰≥ˆÀŸ¬ 2000Hz£¨¥¯øÌ532Hz
+	delay_ms(10);
+	//≈‰÷√µÁ‘¥ƒ£ Ω
+	BMI088_Write_Gyro_Data(GYRO_POWER,0x00);															//’˝≥£ƒ£ Ω
+	delay_ms(10);
+	
+	delay_ms(100);
+
+	cali_retries = 10U * CALI_NUM;
+	while(!GetStill && --cali_retries)             //÷™µ¿ºÏ≤‚æ≤÷π≤≈≥ˆÀ¿—≠ª∑
+	{
+	  GetStill = GetOffset();
+	}
+	if (!GetStill)
+	{
+		sensor.sensor_ok = 0U;
+		return FALSE;
+	}
+	sensor.sensor_ok = 1U;
+	return TRUE;
+}
