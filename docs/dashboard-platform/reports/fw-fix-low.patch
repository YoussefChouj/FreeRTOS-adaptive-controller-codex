-        e->P[5 * 9U + 5U] += e->Q_diag[5];
-        e->P[6 * 9U + 6U] += e->Q_diag[6];
-        e->P[7 * 9U + 7U] += e->Q_diag[7];
-        e->P[8 * 9U + 8U] += e->Q_diag[8];
