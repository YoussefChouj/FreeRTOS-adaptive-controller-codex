+//AnoOF_GetOneByteÊòØÂàùÁ∫ßÊï∞ÊçÆËß£ÊûêÂáΩÊï∞Ôºå‰∏≤Âè£ÊØèÊé•Êî∂Âà∞‰∏ÄÂ≠óËäÇÂÖâÊµÅÊï∞ÊçÆÔºåË∞ÉÁî®Êú¨ÂáΩÊï∞‰∏ÄÊ¨°ÔºåÂáΩÊï∞ÂèÇÊï∞Â∞±ÊòØ‰∏≤Âè£Êî∂Âà∞ÁöÑÊï∞ÊçÆ
+//ÂΩìÊú¨ÂáΩÊï∞Â§öÊ¨°Ë¢´Ë∞ÉÁî®ÔºåÊúÄÁªàÊé•Êî∂Âà∞ÂÆåÊï¥ÁöÑ‰∏ÄÂ∏ßÊï∞ÊçÆÂêéÔºå‰ºöËá™Âä®Ë∞ÉÁî®Êï∞ÊçÆËß£ÊûêÂáΩÊï∞AnoOF_DataAnl
+void AnoOF_GetOneByte(uint8_t data)
+{
+	static u8 _data_len = 0, _data_cnt = 0;
+	static u8 rxstate = 0;
+
+	if (rxstate == 0 && data == 0xAA)
+	{
+		rxstate = 1;
+		_datatemp[0] = data;
+	}
+	//else if (rxstate == 1 && (data == HW_TYPE || data == HW_ALL))
+	else if (rxstate == 1 )
+	{
+		rxstate = 2;
+		_datatemp[1] = data;
+	}
+	else if (rxstate == 2)
+	{
+		rxstate = 3;
+		_datatemp[2] = data;
+	}
+	else if (rxstate == 3 && data <= (sizeof(_datatemp) - 6U))
+	{
+		rxstate = 4;
+		_datatemp[3] = data;
+		_data_len = data;
+		_data_cnt = 0;
+	}
+	else if (rxstate == 4 && _data_len > 0)
+	{
+		_data_len--;
+		_datatemp[4 + _data_cnt++] = data;
+		if (_data_len == 0)
+			rxstate = 5;
+	}
+	else if (rxstate == 5)
+	{
+		rxstate = 6;
+		_datatemp[4 + _data_cnt++] = data;
+	}
+	else if (rxstate == 6)
+	{
+		rxstate = 0;
+		_datatemp[4 + _data_cnt] = data;
+		//		DT_data_cnt = _data_cnt+5;
+		//
+		check_time_ms[0] = 0;
+		AnoOF_DataAnl(_datatemp, _data_cnt + 5); //
+	}
+	else
+	{
+		rxstate = 0;
+	}
+}
+//AnoOF_DataAnl‰∏∫ÂÖâÊµÅÊï∞ÊçÆËß£ÊûêÂáΩÊï∞ÔºåÂèØ‰ª•ÈÄöËøáÊú¨ÂáΩÊï∞ÂæóÂà∞ÂÖâÊµÅÊ®°ÂùóËæìÂá∫ÁöÑÂêÑÈ°πÊï∞ÊçÆ
+//ÂÖ∑‰ΩìÊï∞ÊçÆÁöÑÊÑè‰πâÔºåËØ∑ÂèÇÁÖßÂåøÂêçÂÖâÊµÅÊ®°Âùó‰ΩøÁî®ÊâãÂÜåÔºåÊúâËØ¶ÁªÜÁöÑ‰ªãÁªç
+
+static void AnoOF_DataAnl(uint8_t *data, uint8_t len)
+{
+	u8 check_sum1 = 0, check_sum2 = 0;
+	if (*(data + 3) != (len - 6)) //Âà§Êñ≠Êï∞ÊçÆÈïøÂ∫¶ÊòØÂê¶Ê≠£Á°Æ
+		return;
+	for (u8 i = 0; i < len - 2; i++)
+	{
+		check_sum1 += *(data + i);
+		check_sum2 += check_sum1;
+	}
+	if ((check_sum1 != *(data + len - 2)) || (check_sum2 != *(data + len - 1))) //Âà§Êñ≠sumÊ†°È™å
+		return;
+	//================================================================================
+
+	if (*(data + 2) == 0X51) //ÂÖâÊµÅ‰ø°ÊÅØ
+	{
+		if (*(data + 4) == 0) //ÂéüÂßãÂÖâÊµÅ‰ø°ÊÅØ
+		{
+			ano_of.of0_sta = *(data + 5);
+			ano_of.of0_dx = *(data + 6);
+			ano_of.of0_dy = *(data + 7);
+			ano_of.of_quality = *(data + 8);
+		}
+		else if (*(data + 4) == 1) //È´òÂ∫¶ËûçÂêàÂêéÂÖâÊµÅ‰ø°ÊÅØ
+		{
+			ano_of.of1_sta = *(data + 5);
+			ano_of.of1_dx = *((s16 *)(data + 6));
+			ano_of.of1_dy = *((s16 *)(data + 8));
+			ano_of.of_quality = *(data + 10);
+			//
+			check_time_ms[1] = 0;
+			ano_of.of_update_cnt++;
+		}
+		else if (*(data + 4) == 2) //ÊÉØÂØºËûçÂêàÂêéÂÖâÊµÅ‰ø°ÊÅØ
+		{
+			ano_of.of2_sta = *(data + 5);
+			ano_of.of2_dx = *((s16 *)(data + 6));
+			ano_of.of2_dy = *((s16 *)(data + 8));
+			ano_of.of2_dx_fix = *((s16 *)(data + 10));
+			ano_of.of2_dy_fix = *((s16 *)(data + 12));
+			ano_of.intergral_x = *((s16 *)(data + 14));
+			ano_of.intergral_y = *((s16 *)(data + 16));
+			ano_of.of_quality = *(data + 18);
+			//
+		}
+	}
+	else if (*(data + 2) == 0X34) //È´òÂ∫¶‰ø°ÊÅØ
+	{
+		ano_of.of_alt_cm = *((u32 *)(data + 7));
+		//
+		check_time_ms[2] = 0;
+		ano_of.alt_update_cnt++;
+	}
+	else if (*(data + 2) == 0X01) //ÊÉØÊÄßÊï∞ÊçÆ
+	{
+		ano_of.acc_data_x = *((s16 *)(data + 4));
+		ano_of.acc_data_y = *((s16 *)(data + 6));
+		ano_of.acc_data_z = *((s16 *)(data + 8));
+		ano_of.gyr_data_x = *((s16 *)(data + 10));
+		ano_of.gyr_data_y = *((s16 *)(data + 12));
+		ano_of.gyr_data_z = *((s16 *)(data + 14));
+		//shock_sta+16
+	}
+	else if (*(data + 2) == 0X04) //ÂßøÊÄÅ‰ø°ÊÅØ
+	{
+		//ÂõõÂÖÉÊï∞Ê†ºÂºè
+		ano_of.quaternion[0] = (*((s16 *)(data + 4))) * 0.0001f;
+		ano_of.quaternion[1] = (*((s16 *)(data + 6))) * 0.0001f;
+		ano_of.quaternion[2] = (*((s16 *)(data + 8))) * 0.0001f;
+		ano_of.quaternion[3] = (*((s16 *)(data + 10))) * 0.0001f;
+	}
+}
