-/* SOS blink for the panic loop */
-static void blink_dash(void)
-{
-    LED_RED_ON();
-    delay_loops(BLINK_DELAY_DASH);
-    LED_RED_OFF();
-    delay_loops(BLINK_DELAY_UNIT);
