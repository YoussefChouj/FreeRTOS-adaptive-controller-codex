+		
+		TIM_OC2Init ( TIM4, &TIM_OCInitStructure );
+		TIM_OC2PreloadConfig(TIM4, TIM_OCPreload_Enable);
+
+    TIM_CtrlPWMOutputs ( TIM4, ENABLE );
+    TIM_ARRPreloadConfig ( TIM4, ENABLE );
+    TIM_Cmd ( TIM4, ENABLE );
+		
+		Set_Zero_Motors();
+		//SetRollAngle(0);
+}
+
+//180ÔøΩ»∂ÔøΩÔøΩÔøΩÔøΩ  1us
+//0.5ms  ---0ÔøΩÔøΩ     500
+//1.0ms ----45ÔøΩÔøΩ   1000
+//1.5ms ----90ÔøΩÔøΩ    1500
+//2.0ms -----135ÔøΩÔøΩ  2000
+//2.5ms ----180ÔøΩÔøΩ    2500
+
+void SetPitchAngle(float angle)
+{	
+    TIM_SetCompare2(TIM4 , (2.5f + 10*angle/180)/100*20000);   // ÔøΩﬁ∏ÔøΩ TIM4_CCR1 ÔøΩÔøΩÔøΩÔøΩÔøΩÔøΩ’ºÔøΩ’±ÔøΩ
+}
+
+void SetRollAngle(float angle)
+{
+    TIM_SetCompare1(TIM4 , (2.5f + 10*angle/180)/100*20000);   // ÔøΩﬁ∏ÔøΩ TIM4_CCR1 ÔøΩÔøΩÔøΩÔøΩÔøΩÔøΩ’ºÔøΩ’±ÔøΩ
+}
+
+void Set_PWM_Motors(void)  //ÔøΩÔøΩÔøΩ√µÔøΩÔøΩ  
+{
+  // CONSTRAINT: Macro mapping M1/M4/M2/M3 in pwm.h is intentional and must not be reordered independently.
+  // ARCH: This layer clamps and forwards mixer outputs; it does not redefine axis signs.
+	value_limit( mymotor.motor1 , Motor_PWM_ZERO , Motor_PWM_MAX );		
+	M1=mymotor.motor1;
+	
+	value_limit( mymotor.motor2 , Motor_PWM_ZERO , Motor_PWM_MAX );		
+	M2=mymotor.motor2;
+	
+	value_limit( mymotor.motor3 , Motor_PWM_ZERO , Motor_PWM_MAX );		
+	M3=mymotor.motor3;
+	
+	value_limit( mymotor.motor4 , Motor_PWM_ZERO , Motor_PWM_MAX );		
+	M4=mymotor.motor4;
+	
+}
+
+void Set_Zero_Motors(void)
+{
+	 M1 = Motor_PWM_ZERO;
+	 M2 = Motor_PWM_ZERO; 
+	 M3 = Motor_PWM_ZERO;
+	 M4 = Motor_PWM_ZERO;
+}
+
+void Set_IDLE_Motors(void)
+{
+	 M1 = Motor_PWM_IDLE;
+	 M2 = Motor_PWM_IDLE;
+	 M3 = Motor_PWM_IDLE;
+	 M4 = Motor_PWM_IDLE;
+}
+
+void SetBeep(int B)
+{
+	if(B==0)
+	{
+		TIM_SetCompare3(TIM4 , 0);     //ÔøΩÔøΩÔøΩÔøΩÔøΩÔøΩÔøΩÛø¥µÔøΩÔøΩÔøΩÔøΩÔøΩ    ƒø«∞ÔøΩ«∑ÔøΩÔøΩÔøΩÔøΩÔøΩ
+    //0---->ÔøΩÔøΩÔøΩÔøΩ      1500----->ÔøΩ–µÔøΩÔøΩÔøΩÔøΩÔøΩ
+	}
+	else
+	{
+		TIM_SetCompare3(TIM4 , 1000);
+	}
+}
