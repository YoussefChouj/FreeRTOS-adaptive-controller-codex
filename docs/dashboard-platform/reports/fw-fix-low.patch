-    }
-
-    /* S = H*PHt + R = (P[vel][vel] - P[vel][bias]) - (P[bias][vel] - P[bias][bias]) + R
-     *       = P[vel][vel] - 2*P[vel][bias] + P[bias][bias] + R */
-    S = e->P[vel_idx*6 + vel_idx]
-      - 2.0f * e->P[vel_idx*6 + bias_idx]
-      + e->P[bias_idx*6 + bias_idx]
-      + e->R_of;
