+//◊Ó–°∂˛≥À∑®
+FP32 leastSquareLinearFit(FP32 x[], FP32 y[], const int num)  
+{
+ FP32 a = 0;
+ //FP32 b = 0;
+ FP32 sum_x = 0.0;
+ FP32 sum_y = 0.0;
+ FP32 sum_x2 = 0.0;
+ FP32 sum_xy = 0.0;
+
+ for (int i = 0; i < num; ++i) {
+ sum_x2 += x[i]*x[i];
+ sum_y += y[i];
+ sum_x += x[i];
+ sum_xy += x[i]*y[i];
+ }
+ 
+ FP32 c = num*sum_x2 - sum_x*sum_x;
+  if(c == 0)
+	{
+	  a = 10000;
+	}
+	else
+	{
+	  a = (num*sum_xy - sum_x*sum_y)/(num*sum_x2 - sum_x*sum_x);
+	}
+ //b = (sum_x2*sum_y - sum_x*sum_xy)/(num*sum_x2-sum_x*sum_x);
+ return a;
+}
