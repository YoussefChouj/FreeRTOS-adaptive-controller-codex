-void SysID_Update(void)
-{
-    float env, raw;
-
-    if (s_state == SYSID_IDLE) {
-        s_rate_cmd = 0.0f;
-        return;
-    }
-
-    if (s_state == SYSID_RECOVERY) {
-        s_rate_cmd = 0.0f;
