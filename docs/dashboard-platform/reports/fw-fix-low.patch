+USHORT16 USART_Receive(USART_RX_TypeDef* USARTx)
+{ 
+	USARTx->rxConter = USARTx->DMALen - DMA_GetCurrDataCounter(USARTx->DMAy_Streamx);  //Êú¨Ê¨°DMAÁºìÂÜ≤Âå∫Â°´ÂÖÖÂà∞ÁöÑ‰ΩçÁΩÆ
+
+	USARTx->rxBufferPtr += USARTx->rxSize;  //‰∏äÊ¨°DMAÁºìÂÜ≤Âå∫Â°´ÂÖÖÂà∞ÁöÑ‰ΩçÁΩÆ
+
+	if(USARTx->rxBufferPtr >= USARTx->DMALen)//ËØ¥ÊòéDMAÁºìÂÜ≤Âå∫Â∑≤ÁªèÊª°‰∫Ü‰∏ÄÊ¨°
+	{
+		USARTx->rxBufferPtr %= USARTx->DMALen;
+	}
+
+	if(USARTx->rxBufferPtr < USARTx->rxConter)
+	{
+		USARTx->rxSize = USARTx->rxConter - USARTx->rxBufferPtr; //ËÆ°ÁÆóÊú¨Ê¨°Êé•Êî∂Êï∞ÊçÆÁöÑÈïøÂ∫¶
+		if(USARTx->rxSize <= USARTx->MbLen) 
+		{
+			for(u16 i=0;i<USARTx->rxSize;i++)  *(USARTx->pMailbox + i) = *(USARTx->pDMAbuf + USARTx->rxBufferPtr + i);
+		}
+	}
+	else
+	{
+		USARTx->rxSize = USARTx->rxConter + USARTx->DMALen - USARTx->rxBufferPtr;//ËÆ°ÁÆóÊú¨Ê¨°Êé•Êî∂Êï∞ÊçÆÁöÑÈïøÂ∫¶
+		if(USARTx->rxSize <= USARTx->MbLen) //Êé•Êî∂ÁöÑÊï∞ÊçÆÈïøÂ∫¶‰∏çË∂ÖËøáÊúüÊúõÊï∞ÊçÆÈïøÂ∫¶ÔºåÊääÊï∞ÊçÆÂÜôËøõÈÇÆÁÆ±ÔºåÈò≤Ê≠¢Êï∞ÁªÑË∂äÁïå
+		
+		{
+			for(u16 i=0;i<USARTx->rxSize-USARTx->rxConter;i++) *(USARTx->pMailbox + i) = *(USARTx->pDMAbuf + USARTx->rxBufferPtr + i);
+			for(u16 i=0;i<USARTx->rxConter;i++) *(USARTx->pMailbox + USARTx->rxSize-USARTx->rxConter + i) = *(USARTx->pDMAbuf + i);
+		}
+	}
+	return USARTx->rxSize;  //ËøîÂõûÊú¨Ê¨°Á©∫Èó≤‰∏≠Êñ≠‰∏ÄÂÖ±Êé•Êî∂Â§öÂ∞ëÂ≠óËäÇ
+}
