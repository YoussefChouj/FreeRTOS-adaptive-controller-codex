+void BMI088_Write_Gyro_Data(UCHAR8 reg_id,UCHAR8 data)
+{
+	GYRO_CS_L;
+	spi2_read_write_byte((USHORT16)((reg_id<<8 | data) &0x7fff));// 0b0111111111111111));
+	GYRO_CS_H;
+	NOP;
+}
