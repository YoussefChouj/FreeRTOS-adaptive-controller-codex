+void AnoOF_Check_State(float dT_s)
+{
+	u8 tmp[2];
+	//ËøûÊé•Ê£ÄÊü•
+	if (check_time_ms[0] < 500)
+	{
+		check_time_ms[0]++;
+		ano_of.link_sta = 1;
