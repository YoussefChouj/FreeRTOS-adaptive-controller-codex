+	ACC_CS_L;
+	spi2_read_write_byte((USHORT16)((reg_id<<8 | 0xff) | 0x8000));//0b1000000000000000));				//Dummy_Byte
+	rec = (UCHAR8)(spi2_read_write_byte(0x0000)>>8) & 0xff;
+	ACC_CS_H;
+	NOP;
+	
+	return rec;
+}
