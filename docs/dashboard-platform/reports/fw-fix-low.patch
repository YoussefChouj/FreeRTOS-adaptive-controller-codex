-            e->P[j*6+i]  = e->P[i*6+j];  /* enforce symmetry */
-        }
-    }
-}
-
-void EkfOf_Update(EkfOf_t *e, float of_x, float of_y)
-{
-    if (!e->inited) return;
-    ekf_of_update_one(e, 1, 2, of_x, &e->innov_x);  /* vel_x, bias_x */
-    ekf_of_update_one(e, 4, 5, of_y, &e->innov_y);  /* vel_y, bias_y */
