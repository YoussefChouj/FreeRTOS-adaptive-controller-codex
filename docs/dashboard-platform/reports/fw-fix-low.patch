+UCHAR8 BMI088_Read_Gyro_Data(UCHAR8 reg_id)
+{
+	UCHAR8 rec;
+	
+	GYRO_CS_L;
+	rec = (UCHAR8)(0x00ff & spi2_read_write_byte((USHORT16)((reg_id<<8 | 0x00) | 0x8000)));//0b1000000000000000)));
+	GYRO_CS_H;
+	NOP;
+	
+	
+	return rec;
+}
