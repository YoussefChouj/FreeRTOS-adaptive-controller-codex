-    if (S < 1e-8f) S = 1e-8f;
-
-    /* Innovation */
-    y = of_meas - (e->x[vel_idx] - e->x[bias_idx]);
-    if (innov_out) *innov_out = y;
-
-    /* K = PHt / S */
-    for (i = 0; i < 6; i++) K[i] = PHt[i] / S;
-
-    /* x += K*y */
-    for (i = 0; i < 6; i++) e->x[i] += K[i] * y;
-
-    /* P = (I - K*H) * P * (I - K*H)' + K*R*K'  (Joseph form)
