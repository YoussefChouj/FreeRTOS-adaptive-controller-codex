    "title": "First-Order Step Response & Payload Integral Demo",
    "notes": "Sliders for Kp, Ki, and payload disturbance d.",
    "html": "<!DOCTYPE html>\n<!--\nLicense & Source Attribution (AGPL-3.0):\nAdapted from amosblomqvist/learnharness (https://github.com/amosblomqvist/learnharness, GNU AGPL-3.0).\nSource files: src/agent/prompts/teacher/50-demos.md, src/agent/subagents/demo-builder.ts\n-->\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Interactive Demo: First-Order &amp; Cascade Step Response G(s) = K / (tau*s + 1)</title>\n  <style>\n    :root {\n      --bg: #0f141c;\n      --panel: #18202c;\n      --border: #2c384e;\n      --text: #e6edf3;\n      --muted: #94a3b8;\n      --accent: #38bdf8;\n      --green: #34d399;\n      --amber: #f59e0b;\n      --rose: #fb7185;\n    }\n    body.light-mode {\n      --bg: #f8fafc;\n      --panel: #ffffff;\n      --border: #cbd5e1;\n      --text: #0f172a;\n      --muted: #475569;\n      --accent: #0284c7;\n      --green: #059669;\n      --amber: #d97706;\n      --rose: #e11d48;\n    }\n    * { box-sizing: border-box; }\n    body {\n      margin: 0;\n      padding: 18px;\n      background: var(--bg);\n      color: var(--text);\n      font-family: system-ui, -apple-system, sans-serif;\n    }\n    .wrap {\n      max-width: 980px;\n      margin: 0 auto;\n    }\n    .topbar {\n      display: flex;\n      flex-wrap: wrap;\n      justify-content: space-between;\n      align-items: center;\n      gap: 12px;\n      margin-bottom: 14px;\n    }\n    h1 {\n      font-size: 18px;\n      margin: 0;\n    }\n    .subtitle {\n      font-size: 13px;\n      color: var(--muted);\n      margin-top: 3px;\n    }\n    .btn {\n      background: var(--panel);\n      color: var(--text);\n      border: 1px solid var(--border);\n      border-radius: 6px;\n      padding: 6px 11px;\n      font-size: 12px;\n      cursor: pointer;\n    }\n    .btn:hover { border-color: var(--accent); }\n    .grid {\n      display: grid;\n      grid-template-columns: 310px 1fr;\n      gap: 16px;\n    }\n    @media (max-width: 760px) {\n      .grid { grid-template-columns: 1fr; }\n    }\n    .card {\n      background: var(--panel);\n      border: 1px solid var(--border);\n      border-radius: 10px;\n      padding: 14px;\n    }\n    .control-row {\n      margin-bottom: 12px;\n    }\n    .control-row label {\n      display: flex;\n      justify-content: space-between;\n      font-size: 12px;\n      margin-bottom: 4px;\n    }\n    .control-row input[type=\"range\"] {\n      width: 100%;\n    }\n    .presets {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 6px;\n      margin-top: 8px;\n    }\n    .metrics {\n      display: grid;\n      grid-template-columns: repeat(4, 1fr);\n      gap: 8px;\n      margin-top: 12px;\n    }\n    @media (max-width: 600px) {\n      .metrics { grid-template-columns: repeat(2, 1fr); }\n    }\n    .metric {\n      background: var(--bg);\n      border: 1px solid var(--border);\n      border-radius: 8px;\n      padding: 8px 10px;\n    }\n    .metric .k {\n      font-size: 11px;\n      color: var(--muted);\n    }\n    .metric .v {\n      font-size: 15px;\n      font-weight: 700;\n      margin-top: 2px;\n    }\n    canvas {\n      width: 100%;\n      height: 320px;\n      background: var(--bg);\n      border: 1px solid var(--border);\n      border-radius: 8px;\n      display: block;\n    }\n    .terms {\n      margin-top: 12px;\n      font-size: 12px;\n      color: var(--muted);\n      line-height: 1.5;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"wrap\">\n    <div class=\"topbar\">\n      <div>\n        <h1>First-Order &amp; Cascade Loop Step Response (`G(s) = K / (tau*s + 1)`)</h1>\n        <div class=\"subtitle\">一阶系统阶跃响应 (`yī jiē xì tǒng jiē yuè xiǎng yìng`) &middot; Drag sliders to inspect Gain $K$, Time Constant $\\tau$, and Disturbance $d$.</div>\n      </div>\n      <button type=\"button\" class=\"btn\" id=\"invert-toggle\" onclick=\"document.body.classList.toggle('light-mode'); window.drawStepDemo();\">Toggle Dark / Light</button>\n    </div>\n\n    <div class=\"grid\">\n      <div class=\"card\">\n        <div class=\"control-row\">\n          <label for=\"slider-k\">\n            <span>Gain $K$ (增益 `zēng yì`)</span>\n            <strong id=\"val-k\">1.00</strong>\n          </label>\n          <input type=\"range\" id=\"slider-k\" min=\"0.2\" max=\"2.5\" step=\"0.05\" value=\"1.0\" oninput=\"window.drawStepDemo()\" />\n        </div>\n\n        <div class=\"control-row\">\n          <label for=\"slider-tau\">\n            <span>Time Constant $\\tau$ (时间常数 `shí jiān cháng shù`)</span>\n            <strong id=\"val-tau\">0.50 s</strong>\n          </label>\n          <input type=\"range\" id=\"slider-tau\" min=\"0.1\" max=\"2.0\" step=\"0.05\" value=\"0.5\" oninput=\"window.drawStepDemo()\" />\n        </div>\n\n        <div class=\"control-row\">\n          <label for=\"slider-d\">\n            <span>Load Disturbance $d$ (扰动/载荷 `rǎo dòng`)</span>\n            <strong id=\"val-d\">0.00</strong>\n          </label>\n          <input type=\"range\" id=\"slider-d\" min=\"-0.8\" max=\"0.8\" step=\"0.05\" value=\"0.0\" oninput=\"window.drawStepDemo()\" />\n        </div>\n\n        <div class=\"control-row\">\n          <label for=\"slider-ki\">\n            <span>Integral Action $K_i$ (积分项 `jī fēn xiàng`)</span>\n            <strong id=\"val-ki\">0.00</strong>\n          </label>\n          <input type=\"range\" id=\"slider-ki\" min=\"0.0\" max=\"4.0\" step=\"0.2\" value=\"0.0\" oninput=\"window.drawStepDemo()\" />\n        </div>\n\n        <div class=\"presets\">\n          <button type=\"button\" class=\"btn\" onclick=\"window.setStepPreset(1.0, 0.3, 0.0, 0.0)\">Fast Inner Loop ($\\tau=0.3\\text{ s}$)</button>\n          <button type=\"button\" class=\"btn\" onclick=\"window.setStepPreset(1.0, 1.2, 0.0, 0.0)\">Slow Outer Loop ($\\tau=1.2\\text{ s}$)</button>\n          <button type=\"button\" class=\"btn\" onclick=\"window.setStepPreset(1.0, 0.5, -0.35, 0.0)\">Payload Sag ($d=-0.35, K_i=0$)</button>\n          <button type=\"button\" class=\"btn\" onclick=\"window.setStepPreset(1.0, 0.5, -0.35, 2.0)\">Integral Recovery ($K_i=2.0$)</button>\n        </div>\n\n        <div class=\"terms\">\n          <strong>Key Internship Terms:</strong><br />\n          &bull; <strong>时间常数 ($\\tau$, `shí jiān cháng shù`)</strong>: Time to reach $63.2\\%$ of the step change.<br />\n          &bull; <strong>上升时间 ($t_r \\approx 2.2\\tau$, `shàng shēng shí jiān`)</strong>: $10\\% \\to 90\\%$ transition time.<br />\n          &bull; <strong>稳态误差 ($e_{\\text{ss}}$, `wěn tài wù chā`)</strong>: Offset $r - y(\\infty)$ remaining at steady state.<br />\n          &bull; <strong>角速度环是姿态环的内环</strong>: Inner loop must have smaller $\\tau$ ($3\\text{–}5\\times$ faster bandwidth) than outer loop.\n        </div>\n      </div>\n\n      <div class=\"card\">\n        <canvas id=\"step-canvas\" width=\"640\" height=\"320\"></canvas>\n        <div class=\"metrics\">\n          <div class=\"metric\">\n            <div class=\"k\">63.2% Marker ($t = \\tau$)</div>\n            <div class=\"v\" id=\"m-tau\">0.50 s (y = 0.63)</div>\n          </div>\n          <div class=\"metric\">\n            <div class=\"k\">Rise Time $t_r$ ($10\\text{–}90\\%$)</div>\n            <div class=\"v\" id=\"m-tr\">1.10 s</div>\n          </div>\n          <div class=\"metric\">\n            <div class=\"k\">Steady-State $y(\\infty)$</div>\n            <div class=\"v\" id=\"m-yss\">1.00</div>\n          </div>\n          <div class=\"metric\">\n            <div class=\"k\">Tracking Error $e_{\\text{ss}} = 1 - y(\\infty)$</div>\n            <div class=\"v\" id=\"m-ess\">0.00</div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <script>\n    window.setStepPreset = function (k, tau, d, ki) {\n      document.getElementById('slider-k').value = String(k);\n      document.getElementById('slider-tau').value = String(tau);\n      document.getElementById('slider-d').value = String(d);\n      document.getElementById('slider-ki').value = String(ki);\n      window.drawStepDemo();\n    };\n\n    window.drawStepDemo = function () {\n      var K = parseFloat(document.getElementById('slider-k').value);\n      var tau = parseFloat(document.getElementById('slider-tau').value);\n      var d = parseFloat(document.getElementById('slider-d').value);\n      var Ki = parseFloat(document.getElementById('slider-ki').value);\n\n      document.getElementById('val-k').textContent = K.toFixed(2);\n      document.getElementById('val-tau').textContent = tau.toFixed(2) + ' s';\n      document.getElementById('val-d').textContent = d.toFixed(2);\n      document.getElementById('val-ki').textContent = Ki.toFixed(2);\n\n      var canvas = document.getElementById('step-canvas');\n      var ctx = canvas.getContext('2d');\n      var W = canvas.width;\n      var H = canvas.height;\n      var isLight = document.body.classList.contains('light-mode');\n\n      ctx.clearRect(0, 0, W, H);\n      var padL = 48, padR = 24, padT = 24, padB = 34;\n      var plotW = W - padL - padR;\n      var plotH = H - padT - padB;\n      var tMax = 5.0;\n      var yMin = -0.4, yMax = 2.6;\n\n      function xOf(t) { return padL + (t / tMax) * plotW; }\n      function yOf(y) { return padT + ((yMax - y) / (yMax - yMin)) * plotH; }\n\n      // Grid lines\n      ctx.strokeStyle = isLight ? '#e2e8f0' : '#1e293b';\n      ctx.lineWidth = 1;\n      ctx.fillStyle = isLight ? '#475569' : '#94a3b8';\n      ctx.font = '11px system-ui, sans-serif';\n      for (var yTick = 0; yTick <= 2.5; yTick += 0.5) {\n        var py = yOf(yTick);\n        ctx.beginPath();\n        ctx.moveTo(padL, py);\n        ctx.lineTo(W - padR, py);\n        ctx.stroke();\n        ctx.fillText(yTick.toFixed(1), 12, py + 4);\n      }\n      for (var tTick = 0; tTick <= 5; tTick += 1) {\n        var px = xOf(tTick);\n        ctx.beginPath();\n        ctx.moveTo(px, padT);\n        ctx.lineTo(px, H - padB);\n        ctx.stroke();\n        ctx.fillText(tTick + 's', px - 6, H - 12);\n      }\n\n      // Unit reference line r(t) = 1.0\n      ctx.setLineDash([5, 4]);\n      ctx.strokeStyle = isLight ? '#64748b' : '#94a3b8';\n      ctx.beginPath();\n      ctx.moveTo(padL, yOf(1.0));\n      ctx.lineTo(W - padR, yOf(1.0));\n      ctx.stroke();\n      ctx.setLineDash([]);\n      ctx.fillText('Ref r = 1.0', W - padR - 68, yOf(1.0) - 6);\n\n      // Simulate response y(t)\n      var dt = 0.01;\n      var steps = Math.floor(tMax / dt);\n      var y = 0.0;\n      var zInt = 0.0;\n      var pts = [];\n      var yAtTau = 0.0;\n\n      for (var i = 0; i <= steps; i++) {\n        var t = i * dt;\n        if (Ki <= 0.001) {\n          // Exact first-order response with disturbance offset: y(t) = (K + d) * (1 - exp(-t/tau))\n          y = (K + d) * (1.0 - Math.exp(-t / tau));\n        } else {\n          // Closed-loop with integral term recovering toward r=1.0\n          var err = 1.0 - y;\n          zInt += err * dt;\n          var u = K + Ki * zInt + d;\n          var dydt = (u - y) / tau;\n          y += dydt * dt;\n        }\n        if (Math.abs(t - tau) < dt * 0.6) yAtTau = y;\n        pts.push({ t: t, y: y });\n      }\n\n      // Draw response curve\n      ctx.strokeStyle = isLight ? '#0284c7' : '#38bdf8';\n      ctx.lineWidth = 2.5;\n      ctx.beginPath();\n      for (var j = 0; j < pts.length; j++) {\n        var cx = xOf(pts[j].t);\n        var cy = yOf(pts[j].y);\n        if (j === 0) ctx.moveTo(cx, cy);\n        else ctx.lineTo(cx, cy);\n      }\n      ctx.stroke();\n\n      // Draw tau (63.2%) marker\n      var tauX = xOf(tau);\n      var tauY = yOf(yAtTau);\n      ctx.setLineDash([3, 3]);\n      ctx.strokeStyle = '#f59e0b';\n      ctx.beginPath();\n      ctx.moveTo(tauX, yOf(0));\n      ctx.lineTo(tauX, tauY);\n      ctx.lineTo(padL, tauY);\n      ctx.stroke();\n      ctx.setLineDash([]);\n\n      ctx.fillStyle = '#f59e0b';\n      ctx.beginPath();\n      ctx.arc(tauX, tauY, 4.5, 0, Math.PI * 2);\n      ctx.fill();\n      ctx.fillText('t = tau (' + yAtTau.toFixed(2) + ')', Math.min(tauX + 6, W - 110), Math.max(tauY - 8, padT + 12));\n\n      var yFinal = pts[pts.length - 1].y;\n      var eFinal = 1.0 - yFinal;\n      var tr = 2.197 * tau;\n\n      document.getElementById('m-tau').textContent = tau.toFixed(2) + ' s (y=' + yAtTau.toFixed(2) + ')';\n      document.getElementById('m-tr').textContent = tr.toFixed(2) + ' s';\n      document.getElementById('m-yss').textContent = yFinal.toFixed(2);\n      document.getElementById('m-ess').textContent = (eFinal >= 0 ? '+' : '') + eFinal.toFixed(2);\n    };\n\n    window.drawStepDemo();\n  </script>\n</body>\n</html>\n"
  }
}
